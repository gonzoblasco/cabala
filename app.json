{
  "expo": {
    "name": "Cábala",
    "slug": "cabala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "cabala",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Cábala necesita la cámara para tomar tus 3 fotos diarias.",
        "NSLocationWhenInUseUsageDescription": "Cábala usa tu ubicación para organizar las fotos en un mapa.",
        "NSMicrophoneUsageDescription": "Cábala usa el micrófono para grabar notas de voz en tus entradas."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-router",
      "expo-status-bar"
    ]
  }
}
